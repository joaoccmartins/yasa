# Copy to .env for local dev (cargo run --bin dev / --bin migrate). Never commit .env.

# Pooled connection (Neon: host contains "-pooler"). Used by the API.
DATABASE_URL=postgres:///yasa_dev
# Direct connection. Used only by `cargo run --bin migrate`; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Key that turns a NIF/NIN into a user key. 32 random bytes as hex: `openssl rand -hex 32`.
# Keep it stable per environment: changing it makes every existing invite stop matching.
LOGIN_KEY_SECRET=

# Optional. Days an access read from SIIE stays valid before the next login re-reads it (1-365).
# ACCESS_VALIDITY_DAYS=7

# Optional. Days before an agrupamento's members are imported again, at the next login of anyone
# holding it whole (1-365).
# MEMBERS_SYNC_DAYS=1
